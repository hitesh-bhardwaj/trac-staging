{
    "key": "group_faq_cpt",
    "title": "FAQ Details",
    "fields": [
        {
            "key": "field_faq_answer",
            "label": "Answer",
            "name": "faq_answer",
            "type": "wysiwyg",
            "instructions": "The answer to this FAQ. The question is the post title above.",
            "required": 1,
            "tabs": "all",
            "toolbar": "basic",
            "media_upload": 0,
            "delay": 0
        },
        {
            "key": "field_faq_order",
            "label": "Display Order",
            "name": "faq_order",
            "type": "number",
            "instructions": "Lower numbers appear first (optional - defaults to date order)",
            "required": 0,
            "default_value": 0,
            "min": 0,
            "step": 1
        },
        {
            "key": "field_faq_page",
            "label": "Page",
            "name": "faq_page",
            "type": "taxonomy",
            "instructions": "Which page(s) this FAQ belongs to. Check existing pages, or use \"+ Add New Page\" below the list to create one.",
            "required": 0,
            "taxonomy": "faq_category",
            "field_type": "checkbox",
            "allow_null": 1,
            "add_term": 1,
            "save_terms": 1,
            "load_terms": 1,
            "return_format": "id",
            "multiple": 0
        }
    ],
    "location": [
        [
            {
                "param": "post_type",
                "operator": "==",
                "value": "faq"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
