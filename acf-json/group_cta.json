{
    "key": "group_cta",
    "title": "CTA Section Settings",
    "fields": [
        {
            "key": "field_cta_title",
            "label": "CTA Title",
            "name": "cta_title",
            "type": "text",
            "required": 0,
            "instructions": "Main call-to-action heading"
        },
        {
            "key": "field_cta_para",
            "label": "CTA Paragraph",
            "name": "cta_para",
            "type": "textarea",
            "required": 0,
            "rows": 3,
            "instructions": "Optional supporting text below the title"
        },
        {
            "key": "field_cta_button_text",
            "label": "Button Text",
            "name": "cta_button_text",
            "type": "text",
            "required": 0,
            "instructions": "Text displayed on the CTA button"
        },
        {
            "key": "field_cta_button_link",
            "label": "Button Link",
            "name": "cta_button_link",
            "type": "text",
            "required": 0,
            "instructions": "URL or anchor link for the button",
            "placeholder": "e.g. /contact-us, #solutions, or https://example.com"
        },
        {
            "key": "field_cta_image",
            "label": "Image",
            "name": "cta_image",
            "type": "image",
            "return_format": "url",
            "preview_size": "medium",
            "library": "all",
            "required": 1,
            "instructions": "Image/logo shown beside the CTA text."
        }
    ],
