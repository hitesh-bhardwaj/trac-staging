{
    "key": "group_hero_section",
    "title": "Hero Section",
    "fields": [
        {
            "key": "field_hero_title",
            "label": "Title",
            "name": "hero_title",
            "type": "textarea",
            "instructions": "Each line becomes a separate line in the hero heading. Leave a blank line between lines.",
            "placeholder": "Rwanda's Connectivity\n\nBackbone",
            "rows": 4,
            "required": 1
        },
        {
            "key": "field_hero_subtitle_2",
            "label": "Subtitle (Description)",
            "name": "hero_subtitle_2",
            "type": "textarea",
            "placeholder": "Longer description text",
            "rows": 3,
            "required": 1
        },
        {
            "key": "field_hero_primary_button_text",
            "label": "Primary Button Text",
            "name": "hero_primary_button_text",
            "type": "text",
            "required": 1
        },
        {
            "key": "field_hero_primary_button_link",
            "label": "Primary Button Link",
            "name": "hero_primary_button_link",
            "type": "text",
            "required": 1,
            "placeholder": "e.g. /contact-us, #solutions, or https://example.com"
        },
        {
            "key": "field_hero_secondary_button_text",
            "label": "Secondary Button Text",
            "name": "hero_secondary_button_text",
            "type": "text",
            "required": 1
        },
        {
            "key": "field_hero_secondary_button_link",
            "label": "Secondary Button Link",
            "name": "hero_secondary_button_link",
            "type": "text",
            "required": 1,
            "placeholder": "e.g. /contact-us, #solutions, or https://example.com"
        },
        {
            "key": "field_hero_image",
            "label": "Hero Image",
            "name": "hero_image",
            "type": "image",
            "return_format": "array",
            "preview_size": "medium",
            "library": "all",
            "required": 1
        },
        {
            "key": "field_hero_connectors_svg",
            "label": "Connectors Overlay (SVG)",
            "name": "hero_connectors_svg",
            "type": "file",
            "return_format": "array",
            "mime_types": "svg",
            "required": 1,
            "instructions": "Decorative connector-lines SVG overlaid on the hero image"
        }
    ],
    "location": [
        [
            {
                "param": "page_type",
                "operator": "==",
                "value": "front_page"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}